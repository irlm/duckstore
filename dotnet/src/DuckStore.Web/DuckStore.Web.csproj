<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <!-- blazor.web.js comes from a NuGet package that the SDK adds only when it sees .razor files
         at restore time. The Dockerfile restores with the .csproj alone, so ask for it explicitly. -->
    <RequiresAspNetWebAssets>true</RequiresAspNetWebAssets>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DuckStore.Web.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DuckStore.Contracts\DuckStore.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The Postgres side of the Compare page. The analytics service embeds the *.duckdb.sql files. -->
    <EmbeddedResource Include="..\..\..\analytics\*.postgres.sql" LogicalName="Analytics.%(Filename)%(Extension)" Link="Sql\Analytics\%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
    <PackageReference Include="MudBlazor" Version="9.10.0" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageReference Include="Scalar.AspNetCore" Version="2.17.4" />
  </ItemGroup>

</Project>
