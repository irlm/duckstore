@page "/etl"
@implements IDisposable
@inject AnalyticsApiClient Analytics
@inject StoreQueries Store
@inject ISnackbar Snackbar

<PageTitle>ETL</PageTitle>

<MudStack Row AlignItems="AlignItems.Center" Wrap="Wrap.Wrap" Class="mb-2">
    <MudText Typo="Typo.h4">ETL</MudText>
    <EngineChip Engine="Postgres" Detail="source" />
    <MudIcon Icon="@Icons.Material.Filled.ArrowForward" Size="Size.Small" />
    <EngineChip Engine="DuckDB" Detail="analytics service" />
    <MudSpacer />
    <MudButton Variant="Variant.Filled" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.PlayArrow"
               OnClick="StartAsync" Disabled="@(_run?.IsRunning == true || _starting)">
        @(_run?.IsRunning == true ? "Running…" : "Run ETL now")
    </MudButton>
</MudStack>

<MudText Typo="Typo.body1" Class="mb-4" Style="max-width: 80ch">
    The ETL runs inside the <b>analytics service</b>, the only process that writes the DuckDB file. It copies the store
    from Postgres into a <b>new</b> file, builds the star schema, exports Parquet, then renames the new file over the old
    one. Reports keep answering from the old file until the swap. This page asks the service for progress every second.
</MudText>

@if (_error is not null)
{
    <MudAlert Severity="Severity.Warning" Class="mb-4">@_error</MudAlert>
}

@if (_run is not null)
{
    <MudPaper Outlined Class="pa-4 mb-4">
        <MudStack Row AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
            @if (_run.IsRunning)
            {
                <MudProgressCircular Indeterminate Size="Size.Small" Color="Color.Secondary" />
                <MudText>Running since @_run.StartedAt.ToString("HH:mm:ss") UTC (started from @_run.Trigger): step @_run.Steps.Count of @_run.ExpectedSteps</MudText>
            }
            else if (_run.Error is not null)
            {
                <MudAlert Severity="Severity.Error" Class="flex-grow-1">The run from @_run.Trigger failed: @_run.Error</MudAlert>
            }
            else if (_run.Result is { } result)
            {
                <MudAlert Severity="Severity.Success" Class="flex-grow-1">
                    Done in @result.Duration.TotalSeconds.ToString("F1") s: @((result.SizeBytes / 1e6).ToString("N0")) MB,
                    orders up to #@result.MaxOrderId.ToString("N0"). The reports now read this file.
                </MudAlert>
            }
        </MudStack>
        <MudProgressLinear Color="Color.Secondary" Class="mt-3" Rounded Size="Size.Medium"
                           Value="@(_run.ExpectedSteps == 0 ? 0 : 100.0 * _run.Steps.Count / _run.ExpectedSteps)" />
        <StepTable Steps="@_run.Steps.Select(s => new BuildStep(s.Number, s.Label, s.Rows, s.Duration.TotalSeconds)).ToList()" />
    </MudPaper>
}
else if (_warehouse is not null && _last is not null)
{
    <MudPaper Outlined Class="pa-4 mb-4">
        <MudText Typo="Typo.h6" GutterBottom>Build in use</MudText>
        <MudText Typo="Typo.body2" Class="mb-2">
            Built @_warehouse.BuiltAt.ToString("yyyy-MM-dd HH:mm") UTC in @_warehouse.BuildSeconds.ToString("F1") s,
            orders up to #@_warehouse.MaxOrderId.ToString("N0"), @((_warehouse.SizeBytes / 1e6).ToString("N0")) MB,
            DuckDB @_warehouse.DuckDbVersion. Postgres has @_ordersSinceEtl.ToString("N0") newer orders.
        </MudText>
        <StepTable Steps="@_last.Rows" />
    </MudPaper>
}
else if (_error is null)
{
    <MudProgressLinear Indeterminate Color="Color.Secondary" />
}

<MudText Typo="Typo.body2" Style="opacity: .75">
    Other ways to run it: <code>POST /api/etl/runs</code> on the analytics service, <code>dotnet DuckStore.Analytics.dll etl</code>,
    or a schedule (<code>Etl:ScheduleMinutes</code>). Only one ETL runs at a time.
</MudText>

@code {
    private EtlRunSnapshot? _run;
    private WarehouseInfo? _warehouse;
    private Report<BuildStep>? _last;
    private long _ordersSinceEtl;
    private string? _error;
    private bool _starting;
    private readonly CancellationTokenSource _stop = new();

    protected override async Task OnInitializedAsync()
    {
        await RefreshAsync();
        _ = PollAsync();
    }

    private async Task RefreshAsync()
    {
        try
        {
            _run = await Analytics.EtlStatusAsync(_stop.Token);
            if (_run is null)
            {
                _warehouse = await Analytics.WarehouseAsync(_stop.Token);
                _last = await Analytics.LastBuildStepsAsync(_stop.Token);
                _ordersSinceEtl = await Store.OrdersAfterAsync(_warehouse.MaxOrderId, _stop.Token);
            }
            _error = null;
        }
        catch (AnalyticsServiceException e)
        {
            _error = e.Message;
        }
        catch (HttpRequestException e)
        {
            _error = $"The analytics service is not reachable at {Analytics.BaseAddress}: {e.Message}";
        }
    }

    // While a run is in progress, ask the service for its status every second.
    private async Task PollAsync()
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(1));
        try
        {
            while (await timer.WaitForNextTickAsync(_stop.Token))
            {
                if (_run?.IsRunning != true)
                {
                    continue;
                }
                await RefreshAsync();
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException)
        {
        }
    }

    private async Task StartAsync()
    {
        _starting = true;
        try
        {
            _run = await Analytics.StartEtlAsync();
        }
        catch (AnalyticsServiceException e)
        {
            Snackbar.Add(e.Message, Severity.Warning);
        }
        catch (HttpRequestException e)
        {
            Snackbar.Add($"The analytics service is not reachable: {e.Message}", Severity.Error);
        }
        finally
        {
            _starting = false;
        }
    }

    public void Dispose()
    {
        _stop.Cancel();
        _stop.Dispose();
    }
}
