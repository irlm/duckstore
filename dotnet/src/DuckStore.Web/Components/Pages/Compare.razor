@page "/compare"
@implements IDisposable
@inject ComparisonRunner Runner
@inject AnalyticsApiClient Analytics
@inject NetworkLab NetworkLab
@inject ISnackbar Snackbar

<PageTitle>Compare</PageTitle>

<MudStack Row AlignItems="AlignItems.Center" Wrap="Wrap.Wrap" Class="mb-2">
    <MudText Typo="Typo.h4">Compare: engine and data model</MudText>
    <MudSpacer />
    <MudSelect T="int" @bind-Value="_runs" Label="Timed runs" Dense Variant="Variant.Outlined" Disabled="_busy" Style="max-width: 120px">
        @foreach (var n in new[] { 1, 3, 5, 7 })
        {
            <MudSelectItem Value="n">@n</MudSelectItem>
        }
    </MudSelect>
    <MudCheckBox T="bool" @bind-Value="_warmup" Label="Warm-up run first" Disabled="_busy" />
    <MudSelect T="string" @bind-Value="_network" Label="Network" Dense Variant="Variant.Outlined" Disabled="@(_busy || !_labReady)" Style="max-width: 210px"
               HelperText="@(_labReady ? null : "start the toxiproxy container")">
        @foreach (var code in NetworkCodes)
        {
            <MudSelectItem Value="code">@NetworkSetting.Parse(code).Label</MudSelectItem>
        }
    </MudSelect>
    @if (_runningAll)
    {
        <MudButton Variant="Variant.Outlined" Color="Color.Error" StartIcon="@Icons.Material.Filled.Stop" OnClick="Stop">Stop</MudButton>
    }
    else
    {
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.PlayArrow" OnClick="RunAllAsync"
                   Disabled="@(_busy || _selected.Count == 0)">Run all</MudButton>
    }
</MudStack>

<MudText Typo="Typo.body1" Class="mb-2" Style="max-width: 100ch">
    Each question can run four ways: two <b>engines</b> (Postgres, DuckDB) on two <b>data models</b> (the normalized
    store tables, and the star schema the ETL builds). On the store tables both engines run the <b>same SQL text</b>,
    so the difference is the engine. On the same engine, store tables vs star schema shows what the data model is worth.
    Postgres runs are sent by this web app directly; DuckDB runs go over HTTP to the analytics service and come back as JSON.
    Every approach counts the orders up to the warehouse watermark, and the page checks that all results are equal.
</MudText>
<MudText Typo="Typo.body2" Class="mb-3" Style="max-width: 100ch; opacity: .8">
    Runs are sequential, so they do not compete for the CPU, and the approaches take turns, so a slow moment hits all of them.
    One run can be unlucky (cold caches, another program busy): use a warm-up run and 3-7 timed runs; the page shows the
    <b>median</b> run. <b>Network</b> sends both paths through a proxy that adds a delay in each direction: 1 ms is like
    another server in the same data center, 5 ms another data center in the same city, 25 ms another region.
</MudText>

<MudStack Row Wrap="Wrap.Wrap" Spacing="3" Class="mb-2" AlignItems="AlignItems.Center">
    <MudText Typo="Typo.body2" Style="font-weight: 600">Run:</MudText>
    @foreach (var info in Approaches.All)
    {
        <MudCheckBox T="bool" Value="_selected.Contains(info.Id)" ValueChanged="v => Toggle(info.Id, v)" Label="@info.Name"
                     Disabled="@(_runningAll || _context?.Unavailable(info.Id) is not null)" Dense />
    }
</MudStack>

@if (_context is not null)
{
    <MudText Typo="Typo.body2" Class="mb-2" Style="opacity: .8">@ContextText(_context)</MudText>
    @if (_context.Unavailable(Approach.PostgresStar) is { } why)
    {
        <MudAlert Severity="Severity.Info" Dense Class="mb-3">Postgres · star schema: @why</MudAlert>
    }
}

<MudPaper Outlined Class="pa-3 mb-4">
    <MudStack Row Wrap="Wrap.Wrap" Spacing="4" AlignItems="AlignItems.Center">
        <MudText Typo="Typo.body2" Style="font-weight: 600">Where the time goes:</MudText>
        @foreach (var (kind, text) in Legend)
        {
            <MudText Typo="Typo.body2"><span class="swatch" style="background: @TimingBar.ColorFor(kind, IsDarkMode)"></span>@text</MudText>
        }
    </MudStack>
</MudPaper>

@if (_state.Values.Any(s => s.Measurement is not null))
{
    <MudPaper Outlined Class="pa-3 mb-4">
        <MudText Typo="Typo.h6" Class="mb-2">Summary (medians)</MudText>
        <div class="table-scroll">
            <MudSimpleTable Dense Elevation="0">
                <thead>
                    <tr>
                        <th>Question</th>
                        <th>Network</th>
                        @foreach (var info in Approaches.All)
                        {
                            <th class="num">@info.Name</th>
                        }
                        <th>Engine: DuckDB vs Postgres, store tables</th>
                        <th>Model: star vs store, DuckDB</th>
                        <th>Result</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var a in AnalyticCatalog.All)
                    {
                        if (_state[a.Id].Measurement is not { } m) continue;
                        <tr>
                            <td><a href="@($"compare#{a.Id}")">@a.Title</a></td>
                            <td class="nowrap">@m.Network.Label</td>
                            @foreach (var info in Approaches.All)
                            {
                                <td class="num">@Total(m[info.Id])</td>
                            }
                            <td>@EngineEffect(m.Speedup(Approach.PostgresStore, Approach.DuckDbStore))</td>
                            <td>@ModelEffect(m.Speedup(Approach.DuckDbStore, Approach.DuckDbStar))</td>
                            <td>
                                @if (m.Check is { } c)
                                {
                                    <MudText Typo="Typo.body2" Color="@(c.Same ? Color.Success : Color.Error)">@(c.Same ? "✓ same" : "✗ different")</MudText>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </MudSimpleTable>
        </div>
    </MudPaper>
}

@foreach (var analytic in AnalyticCatalog.All)
{
    var s = _state[analytic.Id];
    <MudPaper Outlined Class="pa-4 mb-4" id="@analytic.Id">
        <MudStack Row AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
            <MudText Typo="Typo.h6">@analytic.Title</MudText>
            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@KindText(analytic.Kind)</MudChip>
            <MudSpacer />
            <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.PlayArrow" Disabled="@(_busy || _selected.Count == 0)"
                       OnClick="() => RunOneAsync(analytic)">@(s.Measurement is null ? "Run" : "Run again")</MudButton>
        </MudStack>
        <MudText Typo="Typo.body2" Class="mt-1">@analytic.Question</MudText>
        <MudText Typo="Typo.body2" Class="mb-3" Style="opacity: .7">@analytic.Explanation</MudText>

        <div class="approach-grid">
            <div class="grid-head">Store tables <span>normalized, as the application writes them</span></div>
            <div class="grid-head">Star schema <span>facts and dimensions built by the ETL</span></div>
            @foreach (var approach in GridOrder)
            {
                var info = approach.Info();
                <ApproachPanel Title="@info.Name" Path="@info.Path" Series="s.Measurement?[approach]" Progress="@s.Progress.GetValueOrDefault(approach)"
                               NetworkLabel="@s.Measurement?.Network.Label"
                               Unavailable="@_context?.Unavailable(approach)"
                               Explain="(analyze, ct) => Runner.ExplainAsync(approach, analytic.Id, _context!, analyze, ct)"
                               PlanHelp="@(info.IsDuckDb ? DuckDbPlanHelp : PostgresPlanHelp)" Busy="_busy"
                               Sql="@SqlFor(analytic.Id, info)" ScaleMs="Scale(s)" />
            }
        </div>

        @if (s.Measurement is { } measurement)
        {
            <MudText Typo="Typo.body2" Class="mt-3">
                <b>Network</b>: @measurement.Network.Label.
                <b>Engine</b> (same data): store tables @EngineEffect(measurement.Speedup(Approach.PostgresStore, Approach.DuckDbStore)),
                star schema @EngineEffect(measurement.Speedup(Approach.PostgresStar, Approach.DuckDbStar)).
                <b>Data model</b> (same engine): on Postgres @ModelEffect(measurement.Speedup(Approach.PostgresStore, Approach.PostgresStar)),
                on DuckDB @ModelEffect(measurement.Speedup(Approach.DuckDbStore, Approach.DuckDbStar)).
            </MudText>
            @if (measurement.Check is { } check)
            {
                <MudAlert Severity="@(check.Same ? Severity.Success : Severity.Warning)" Dense Class="mt-3">
                    @check.Message
                    @if (!check.Same && analytic.Id == "customer-orders")
                    {
                        <span> The store tables show the live status of each order; the star schema shows the status at ETL time.</span>
                    }
                </MudAlert>
            }
        }
    </MudPaper>
}

@code {
    [CascadingParameter(Name = "IsDarkMode")] public bool IsDarkMode { get; set; }

    private sealed class CardState
    {
        public QuestionMeasurement? Measurement;
        public readonly Dictionary<Approach, string> Progress = [];
    }

    // Rows = engine, columns = data model.
    private static readonly Approach[] GridOrder = [Approach.PostgresStore, Approach.PostgresStar, Approach.DuckDbStore, Approach.DuckDbStar];

    private readonly Dictionary<string, CardState> _state = AnalyticCatalog.All.ToDictionary(a => a.Id, _ => new CardState());
    private readonly HashSet<Approach> _selected = [.. Enum.GetValues<Approach>()];
    private Dictionary<(string, DataModel), string> _duckSql = [];
    private ComparisonContext? _context;
    private int _runs = 1;
    private bool _warmup;
    private string _network = "direct";
    private bool _labReady;

    private static readonly string[] NetworkCodes = ["direct", "0", "1", "5", "25"];
    private bool _busy;
    private bool _runningAll;
    private CancellationTokenSource _cts = new();

    private const string PostgresPlanHelp =
        "Read from the most indented line up: it runs first. \"actual time=A..B\" is ms until the first and the last row, " +
        "per loop; compare \"rows\" (estimated) with \"actual rows\". \"Buffers: shared hit\" = pages found in memory, " +
        "\"read\" = pages read from disk, like logical and physical reads in SET STATISTICS IO. " +
        "\"Workers Launched\" = parallel workers, like MAXDOP.";

    private const string DuckDbPlanHelp =
        "Read from the bottom boxes up: the scans run first. Each box is one operator; with the actual plan it shows " +
        "the rows it produced and its time. A scan lists only the columns it reads and the filters pushed into it. " +
        "HASH_GROUP_BY and HASH_JOIN work on thousands of rows at a time, like batch mode in SQL Server.";

    private static readonly (PhaseKind, string)[] Legend =
    [
        (PhaseKind.Database, "database work (execute, produce rows)"),
        (PhaseKind.Transfer, "network: Postgres protocol or HTTP between containers"),
        (PhaseKind.Json, "JSON serialize and parse"),
    ];

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _duckSql = (await Analytics.AnalyticsSqlAsync()).ToDictionary(a => (a.Id, a.Model), a => a.Sql);
        }
        catch (Exception e) when (e is HttpRequestException or AnalyticsServiceException)
        {
            // the DuckDB approaches show as unavailable
        }
        _context = await Runner.PrepareAsync();
        _selected.RemoveWhere(a => _context.Unavailable(a) is not null);
        _labReady = await NetworkLab.IsReachableAsync();
    }

    private void Toggle(Approach approach, bool on)
    {
        if (on) _selected.Add(approach);
        else _selected.Remove(approach);
    }

    private async Task RunOneAsync(AnalyticDefinition analytic)
    {
        _busy = true;
        var ct = NewRun();
        try
        {
            _context = await Runner.PrepareAsync(ct);
            await RunAsync(analytic, ct);
        }
        catch (OperationCanceledException)
        {
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task RunAllAsync()
    {
        _busy = _runningAll = true;
        var ct = NewRun();
        try
        {
            _context = await Runner.PrepareAsync(ct);
            foreach (var analytic in AnalyticCatalog.All)
            {
                ct.ThrowIfCancellationRequested();
                await RunAsync(analytic, ct);
            }
            Snackbar.Add("All questions ran.", Severity.Success);
        }
        catch (OperationCanceledException)
        {
            Snackbar.Add("Stopped.", Severity.Info);
        }
        finally
        {
            _busy = _runningAll = false;
        }
    }

    // One question: the approaches take turns, never at the same time.
    private async Task RunAsync(AnalyticDefinition analytic, CancellationToken ct)
    {
        var s = _state[analytic.Id];
        var chosen = _selected.Where(a => _context!.Unavailable(a) is null).ToList();
        try
        {
            var options = new MeasureOptions(_runs, _warmup ? 1 : 0, chosen, NetworkSetting.Parse(_labReady ? _network : "direct"));
            s.Measurement = await Runner.MeasureAsync(analytic.Id, _context!, options, progress =>
            {
                foreach (var approach in chosen)
                {
                    s.Progress[approach] = approach != progress.Approach ? "Waiting for its turn"
                        : progress.Warmup ? "Warm-up run (not counted)" : $"Run {progress.Run} of {progress.Of}";
                }
                _ = InvokeAsync(StateHasChanged);
            }, ct);
        }
        finally
        {
            s.Progress.Clear();
        }
        StateHasChanged();
    }

    private void Stop() => _cts.Cancel();

    private string SqlFor(string id, ApproachInfo info) => info.IsDuckDb
        ? _duckSql.GetValueOrDefault((id, info.Model)) ?? "(ask the analytics service)"
        : ComparisonRunner.PostgresSqlFor(id, info.Model);

    private static string ContextText(ComparisonContext c)
    {
        var warehouse = c.Warehouse is { } w
            ? $"warehouse built {w.BuiltAt:yyyy-MM-dd HH:mm} UTC, {w.SizeBytes / 1e6:N0} MB, DuckDB {w.DuckDbVersion}, {w.Threads} threads"
            : "the analytics service is not reachable";
        return $"Orders up to #{c.MaxOrderId:N0} ({warehouse}) · lookup customer #{c.CustomerId} · {c.IndexesText}";
    }

    private CancellationToken NewRun()
    {
        if (_cts.IsCancellationRequested)
        {
            _cts.Dispose();
            _cts = new CancellationTokenSource();
        }
        return _cts.Token;
    }

    private static double Scale(CardState s) =>
        s.Measurement?.Series.Select(x => x.Median?.TotalMs ?? 0).DefaultIfEmpty(0).Max() ?? 0;

    private static string Total(ApproachSeries? series) =>
        series is null ? "" : series.Median is { } run ? Format.Ms(run.TotalMs) : "error";

    private static string EngineEffect(double? postgresOverDuckDb) => postgresOverDuckDb switch
    {
        null => "not measured",
        >= 0.9 and <= 1.1 => "about equal",
        >= 1 => $"DuckDB {postgresOverDuckDb:0.#}× faster",
        _ => $"Postgres {1 / postgresOverDuckDb:0.#}× faster",
    };

    private static string ModelEffect(double? storeOverStar) => storeOverStar switch
    {
        null => "not measured",
        >= 0.9 and <= 1.1 => "about equal",
        >= 1 => $"star schema {storeOverStar:0.#}× faster",
        _ => $"store tables {1 / storeOverStar:0.#}× faster",
    };

    private static string KindText(AnalyticKind kind) => kind switch
    {
        AnalyticKind.BigResult => "large result",
        AnalyticKind.Lookup => "lookup by key",
        _ => "analytics",
    };

    public void Dispose()
    {
        _cts.Cancel();
        _cts.Dispose();
    }
}
