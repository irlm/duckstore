@* One way of answering a question: total time, the phase breakdown, the SQL and the rows. *@
<div class="approach">
    <MudStack Row AlignItems="AlignItems.Baseline" Wrap="Wrap.Wrap" Spacing="2">
        <MudText Typo="Typo.subtitle1" Style="font-weight: 600">@Title</MudText>
        <MudText Typo="Typo.caption" Style="opacity: .75">@Path</MudText>
    </MudStack>

    @if (Progress is not null)
    {
        <MudText Typo="Typo.body2" Class="mt-3" Style="opacity: .75">@Progress</MudText>
        <MudProgressLinear Indeterminate Color="Color.Default" Class="mb-4 mt-1" />
    }
    else if (Series is null)
    {
        <MudText Typo="Typo.body2" Class="my-3" Style="opacity: .6">Not run yet.</MudText>
    }
    else if (Series.Error is not null)
    {
        <MudAlert Severity="Severity.Error" Dense Class="my-2">@Series.Error</MudAlert>
    }
    else if (Series.Median is { } run)
    {
        <MudStack Row AlignItems="AlignItems.Baseline" Spacing="3" Class="mt-1">
            <MudText Typo="Typo.h5" Style="font-weight: 600">@Format.Ms(run.TotalMs)</MudText>
            <MudText Typo="Typo.body2" Style="opacity: .75">
                @run.Result!.RowCount.ToString("N0") rows@(run.PayloadBytes is long b ? $" · {Format.Bytes(b)} of JSON" : "")
            </MudText>
        </MudStack>
        @if (Series.Runs.Count > 1)
        {
            <MudText Typo="Typo.caption" Style="opacity: .75" title="@AllRuns(Series)">
                median of @Series.Runs.Count runs · fastest @Format.Ms(Series.MinMs) · slowest @Format.Ms(Series.MaxMs)@(Series.Warmups.Count > 0 ? $" · after {Series.Warmups.Count} warm-up" : "")
            </MudText>
        }
        else if (Series.Warmups.Count > 0)
        {
            <MudText Typo="Typo.caption" Style="opacity: .75">after @Series.Warmups.Count warm-up run (@Format.Ms(Series.Warmups[0].TotalMs))</MudText>
        }
        <TimingBar Phases="run.Phases" ScaleMs="ScaleMs" />
        <table class="phase-table">
            @foreach (var phase in run.Phases)
            {
                <tr>
                    <td><span class="swatch" style="background: @TimingBar.ColorFor(phase.Kind, IsDarkMode)"></span>@phase.Name</td>
                    <td class="num">@Format.Ms(phase.Ms)</td>
                </tr>
            }
        </table>
    }

    <MudStack Row Spacing="1" Class="mt-1">
        <MudButton Size="Size.Small" Variant="Variant.Text" StartIcon="@Icons.Material.Filled.Code" OnClick="() => _showSql = !_showSql">
            @(_showSql ? "Hide SQL" : "SQL")
        </MudButton>
        @if (Series?.Median?.Result is { RowCount: > 0 })
        {
            <MudButton Size="Size.Small" Variant="Variant.Text" StartIcon="@Icons.Material.Filled.TableRows" OnClick="() => _showRows = !_showRows">
                @(_showRows ? "Hide rows" : "Rows")
            </MudButton>
        }
    </MudStack>
    <MudCollapse Expanded="_showSql"><pre class="sql">@Sql</pre></MudCollapse>
    @if (_showRows && Series?.Median?.Result is { } result)
    {
        <div class="rows-preview">
            <MudSimpleTable Dense Elevation="0">
                <thead><tr>@foreach (var c in result.Columns) { <th>@c</th> }</tr></thead>
                <tbody>
                    @foreach (var row in result.Rows.Take(25))
                    {
                        <tr>@foreach (var cell in row) { <td class="@(Format.IsNumber(cell) ? "num" : "")">@Format.Cell(cell)</td> }</tr>
                    }
                </tbody>
            </MudSimpleTable>
            @if (result.RowCount > 25)
            {
                <MudText Typo="Typo.caption">First 25 of @result.RowCount.ToString("N0") rows.</MudText>
            }
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = "";
    [Parameter, EditorRequired] public string Path { get; set; } = "";
    [Parameter] public ApproachSeries? Series { get; set; }

    /// <summary>Set while running, e.g. "Run 2 of 5".</summary>
    [Parameter] public string? Progress { get; set; }
    [Parameter] public string? Sql { get; set; }
    [Parameter] public double ScaleMs { get; set; }
    [CascadingParameter(Name = "IsDarkMode")] public bool IsDarkMode { get; set; }

    private bool _showSql;
    private bool _showRows;

    private static string AllRuns(ApproachSeries series) =>
        "Every run: " + string.Join(", ", series.Runs.Select(r => Format.Ms(r.TotalMs)));
}
