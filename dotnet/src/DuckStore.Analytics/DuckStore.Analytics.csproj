<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DuckStore.Analytics.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- SQL files live at the repository root and are compiled into this assembly:
         etl/ is the ETL (shared with the Go version), analytics/ holds the questions
         of the Compare page. -->
    <EmbeddedResource Include="..\..\..\etl\*.sql" LogicalName="Etl.%(Filename)%(Extension)" Link="Sql\Etl\%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\..\..\etl\incremental\*.sql" LogicalName="EtlIncremental.%(Filename)%(Extension)" Link="Sql\EtlIncremental\%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\..\..\etl\postgres-star\*.sql" LogicalName="PostgresStar.%(Filename)%(Extension)" Link="Sql\PostgresStar\%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\..\..\analytics\**\*.sql" LogicalName="Analytics/%(RecursiveDir)%(Filename)%(Extension)" Link="Sql\Analytics\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DuckStore.Contracts\DuckStore.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Dapper" Version="2.1.86" />
    <PackageReference Include="DuckDB.NET.Data.Full" Version="1.5.5" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <PackageReference Include="Scalar.AspNetCore" Version="2.17.4" />
  </ItemGroup>

</Project>
